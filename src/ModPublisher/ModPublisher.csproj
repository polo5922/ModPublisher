<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- ThemeMode (thème Fluent de Windows 11) est encore marqué expérimental dans .NET 9 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AssemblyTitle>ModPublisher</AssemblyTitle>
    <Version>1.1.0</Version>
    <!-- Pas de chemins du PC de compilation dans la version publiée -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Company>GameAndDev</Company>
    <Product>ModPublisher</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

</Project>
