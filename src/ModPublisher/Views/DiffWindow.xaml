<Window x:Class="ModPublisher.Views.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:l="clr-namespace:ModPublisher.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{l:T 'Différences', 'Differences'}" Width="1000" Height="750" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="OnlyChanges" Content="{l:T 'Seulement les lignes modifiées', 'Changed lines only'}" IsChecked="True" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <TextBlock x:Name="Summary" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
        </StackPanel>
        <ListBox x:Name="Lines" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" VirtualizingPanel.IsVirtualizing="True">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4,1"/>
                    <Setter Property="MinHeight" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Added">
                            <Setter Property="Background" Value="#3022C55E"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Removed">
                            <Setter Property="Background" Value="#30EF4444"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding Prefix, Mode=OneWay}"/><Run Text="{Binding Text, Mode=OneWay}"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
